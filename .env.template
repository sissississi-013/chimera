# Chimera Environment Configuration Template
# Copy this file to .env and fill in your values

# Backend Configuration
BACKEND_PORT=8000
DEBUG=true

# Payment Configuration (when ready for production)
# COINBASE_CDP_API_KEY=your_coinbase_api_key
# COINBASE_CDP_API_SECRET=your_coinbase_api_secret
# COINBASE_WALLET_ADDRESS=your_wallet_address

# STRIPE_API_KEY=your_stripe_api_key
# STRIPE_SECRET_KEY=your_stripe_secret_key

# External API Keys (for production integrations)
# TOXICITY_API_KEY=your_toxicity_api_key
# EFFICACY_API_KEY=your_efficacy_api_key
# MARKETPLACE_API_KEY=your_marketplace_api_key

# Agent Configuration
MOCK_MODE=true
MOCK_API_MODE=true
DEFAULT_WALLET_BALANCE=100.0

# Database (for future use)
# DATABASE_URL=postgresql://user:password@localhost/chimera

# Redis (for future use)
# REDIS_URL=redis://localhost:6379
