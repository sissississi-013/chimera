# ===================================
# CHIMERA AUTONOMOUS AGENT - ENV CONFIG
# ===================================
# Copy this file to .env and fill in your actual credentials

# ----- STRIPE (Fiat Payments) -----
STRIPE_SECRET_KEY=sk_test_...  # Get from: Stripe Dashboard > Developers > API Keys
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...  # Get from: Stripe Dashboard > Developers > Webhooks

# ----- COINBASE CDP (Crypto Wallet & x402) -----
CDP_API_KEY_ID=...  # Get from: Coinbase Developer Platform
CDP_API_KEY_SECRET=...
CDP_WALLET_SECRET=...  # For managing agent's wallet
AGENT_WALLET_ADDRESS=0x...  # Your agent's EVM wallet address (Base testnet)
# Base Sepolia Network (testnet)
BLOCKCHAIN_NETWORK=base-sepolia
USDC_CONTRACT_ADDRESS=0x...  # Base Sepolia USDC address

# ----- LOCUS (Spending Controls) -----
LOCUS_API_KEY=...  # Get from: paywithlocus.com dashboard
LOCUS_AGENT_ID=...  # Your agent identity in Locus
LOCUS_API_URL=https://api.paywithlocus.com/v1

# ----- NVIDIA BioNeMo (Molecule Generation & Protein Folding) -----
NVIDIA_API_KEY=...  # Get from: NVIDIA NGC/BioNeMo Cloud
NVIDIA_API_URL=https://health.api.nvidia.com/v1

# ----- Hugging Face (Optional - for open-source models) -----
HUGGINGFACE_API_TOKEN=...  # Get from: huggingface.co/settings/tokens

# ----- NeuroSnap (Toxicity & Synthesizability) -----
NEUROSNAP_API_KEY=...  # Get from: neurosnap.ai
NEUROSNAP_API_URL=https://api.neurosnap.ai/v1

# ----- Application Settings -----
# Payment Mode: 'test' or 'live'
PAYMENT_MODE=test

# Pricing (in USD)
PRICE_MOLECULE_GENERATION=0.01
PRICE_STRUCTURE_PREDICTION=0.05
PRICE_TOXICITY_CHECK=0.005
PRICE_FULL_PIPELINE=0.10

# Fallback Settings
ENABLE_FALLBACKS=true  # Use cached/local models if APIs fail
USE_LOCAL_MODELS=false  # Set to true to prefer local models over APIs

# ----- Demo/Development Settings -----
DEMO_MODE=false  # Set to true to bypass payment checks
MOCK_PAYMENTS=false  # Set to true to simulate payments without real transactions
CACHE_RESULTS=true  # Cache API results for faster repeated requests

# ----- Server Settings -----
BACKEND_PORT=8000
FRONTEND_PORT=3000
WEBHOOK_BASE_URL=https://your-domain.com  # Or ngrok URL for development
